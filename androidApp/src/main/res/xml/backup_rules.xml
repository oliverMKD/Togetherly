<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android-12 (API 23-30) Auto Backup rules. Togetherly disables backup at the manifest
    level (`android:allowBackup="false"`), but this file remains a defensive, explicit policy
    declaration for the older platform format and for any future build-time validation. It
    excludes every user-generated storage domain Togetherly uses, so no data that belongs only to
    a family is left eligible for backup by accident.
-->
<full-backup-content>
    <exclude domain="root" path="./" />
    <exclude domain="file" path="./" />
    <exclude domain="database" path="togetherly.db" />
    <exclude domain="database" path="togetherly.db-wal" />
    <exclude domain="database" path="togetherly.db-shm" />
    <exclude domain="external" path="./" />
    <exclude domain="device_root" path="./" />
    <exclude domain="device_file" path="./" />
    <exclude domain="device_database" path="togetherly.db" />
    <exclude domain="device_database" path="togetherly.db-wal" />
    <exclude domain="device_database" path="togetherly.db-shm" />
</full-backup-content>
